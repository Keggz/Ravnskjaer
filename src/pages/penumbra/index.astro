---
import { languageFor, localUrl, translate } from '../../lib/i18n';
import { penumbraCategories, penumbraUrl } from '../../lib/penumbra';
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const lang = languageFor(Astro.url.pathname);
const t = (text: string) => translate(text, lang);
const url = (path: string) => localUrl(path, lang);
const oppslag = (await getCollection('penumbra', ({ data }) => !data.skjult)).sort((a, b) => a.data.tittel.localeCompare(b.data.tittel, 'nb'));
const grupper = penumbraCategories.map(category => ({ ...category, poster: oppslag.filter(o => o.data.type === category.type) }));
---
<Base tittel="Penumbra" beskrivelse={t("Oppdagelser, steder og ånder på den andre siden av Ravnskjær.")}>
  <div class="innhold">
    <section class="terskel">
      <span class="mane" aria-hidden="true">☾</span>
      <p class="stikk">{t("På den andre siden")}</p>
      <h1>Penumbra</h1>
      <p class="ingress">{t("Et sted for det dere oppdager bortenfor den synlige verdenen. Ånder, steder og forbindelser som får en annen betydning på den andre siden.")}</p>
      <a href={url("/")} class="tilbake">{t("← Tilbake til Ravnskjær")}</a>
    </section>
    <nav class="kategorier" aria-label={t("Utforsk Penumbra")}>{grupper.map(g => <a href={url('/penumbra/' + g.slug)}>{t(g.title)} <span>{g.poster.length}</span></a>)}</nav>
    {oppslag.length ? grupper.filter(g => g.poster.length).map(g => (
      <section class="samling">
        <h2><a href={url('/penumbra/' + g.slug)}>{t(g.title)}</a></h2>
        <ul class="oppdagelser">
          {g.poster.map(p => <li><a href={url(penumbraUrl(p))}><h3>{t(p.data.tittel)}</h3><p>{t(p.data.kort)}</p><span>{t("Åpne oppslag →")}</span></a></li>)}
        </ul>
      </section>
    )) : (
      <section class="stille">
        <h2>{t("Den andre siden venter")}</h2>
        <p>{t("Ingen oppdagelser er ført inn her ennå. Etter hvert samles det dere lærer om Penumbra på disse sidene.")}</p>
        <div class="spor"><span>{t("Steder")}</span><span>{t("Ånder")}</span><span>{t("Kunnskap")}</span></div>
      </section>
    )}
  </div>
</Base>
<style>
  .kategorier { display: flex; flex-wrap: wrap; justify-content: center; gap: .7rem; margin-bottom: 2.5rem; }
  .kategorier a { padding: .6rem 1rem; border: 1px solid var(--kant); border-radius: var(--radius); text-decoration: none; background: var(--sot); }
  .kategorier span { margin-left: .5rem; color: var(--tekst-dempet); }
  .terskel { padding: 3.5rem 0; max-width: 44rem; margin: auto; text-align: center; }
  .mane { display: block; font-size: 4rem; color: var(--bronse-lys); line-height: 1; margin-bottom: 1.5rem; }
  h1 { font-size: clamp(2.8rem, 8vw, 5rem); }
  .tilbake { display: inline-block; margin-top: 1rem; padding: .5rem; font-size: .9rem; }
  .stille { text-align: center; max-width: 42rem; margin: 0 auto 3rem; padding: 2rem; border: 1px solid var(--kant); border-radius: 12px; background: var(--sot); }
  .stille p { color: var(--tekst-dempet); }
  .spor { display: flex; flex-wrap: wrap; justify-content: center; gap: 1rem; color: var(--bronse-lys); font-size: .85rem; }
  .samling { margin-bottom: 2rem; }
  .oppdagelser { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr)); gap: 1rem; }
  .oppdagelser a { display: block; padding: 1.5rem; background: var(--sot); border: 1px solid var(--kant); border-radius: 8px; text-decoration: none; height: 100%; overflow-wrap: anywhere; }
  .oppdagelser p { color: var(--tekst-dempet); }
  .oppdagelser span { font-size: .8rem; }
</style>
