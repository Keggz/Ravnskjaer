---
import { getCollection } from 'astro:content';
import { penumbraUrl } from '../../lib/penumbra';
export async function getStaticPaths() {
  return (await getCollection('penumbra', ({ data }) => !data.skjult)).map(entry => ({ params: { id: entry.id }, props: { url: penumbraUrl(entry) } }));
}
return Astro.redirect(Astro.props.url, 301);
