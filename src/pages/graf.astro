---
import { languageFor, localUrl, translate } from '../lib/i18n';
import Base from '../layouts/Base.astro';
import { hentAlle, grafData, sjekkRelasjoner } from '../lib/bibliotek';
const lang = languageFor(Astro.url.pathname);
const t = (text: string) => translate(text, lang);
const url = (path: string) => localUrl(path, lang);

const alle = await hentAlle(lang);
const graf = grafData(alle);

// Advar i terminalen hvis noen relasjoner peker på oppslag som ikke finnes.
for (const feil of sjekkRelasjoner(alle)) {
  console.warn(`[Ravnskjær] Ugyldig relasjon: ${feil}`);
}
---

<Base tittel={t("Relasjoner")}>
  <div class="innhold">
    <div class="sidetopp">
      <p class="stikk">{t("Bibliotek")}</p>
      <h1>{t("Relasjoner")}</h1>
      <p class="ingress">
        {t("Start med folkene i Ravnskjær. Velg hva du vil se, eller klikk på et navn for å utforske de nærmeste forbindelsene.")}
      </p>
    </div>

    <div class="graf-kontroller">
      <div class="visninger" role="group" aria-label={t("Visning")}>
        <button type="button" data-visning="folk" aria-pressed="true">{t("Folk")}</button>
        <button type="button" data-visning="steder" aria-pressed="false">{t("Folk og steder")}</button>
        <button type="button" data-visning="hendelser" aria-pressed="false">{t("Folk og hendelser")}</button>
        <button type="button" data-visning="alt" aria-pressed="false">{t("Alt")}</button>
      </div>
      <div class="verktoy">
        <label>{t("Søk etter navn eller rolle")}
          <input type="search" id="graf-sok" placeholder={t("F.eks. Torstein eller skald")} autocomplete="off" />
        </label>
        <label>{t("Fokuser på")}
          <select id="graf-fokus"><option value="">{t("Hele visningen")}</option></select>
        </label>
        <button type="button" id="graf-nullstill">{t("Nullstill")}</button>
      </div>
      <p class="graf-hjelp">{t("Søk viser treffene og deres direkte forbindelser. Dra i punktene for å flytte dem.")}</p>
    </div>
    <div class="graf-status">
      <p id="graf-antall" role="status" aria-live="polite"></p>
      <div class="tegnforklaring" aria-label={t("Farger")}>
        <span><i class="prikk karakterer"></i> {t("Folk")}</span>
        <span data-forklaring="steder" hidden><i class="prikk steder"></i> {t("Steder")}</span>
        <span data-forklaring="hendelser" hidden><i class="prikk hendelser"></i> {t("Hendelser")}</span>
      </div>
    </div>

    {graf.noder.length === 0 ? (
      <p class="tom-melding">{t("Ingen oppslag å vise ennå.")}</p>
    ) : (
      <div class="graf-ramme">
        <svg id="graf" role="group" aria-label={t("Relasjoner i valgt visning")}></svg>
        <p id="graf-tom" class="tom-melding" hidden>{t("Ingen treff i denne visningen. Prøv et annet navn eller nullstill filtrene.")}</p>
        <p class="graf-fallback">
          {t("Kartet krever JavaScript. Du finner alt innholdet under")}
          <a href={url("/karakterer")}>{t("Folk")}</a>, <a href={url("/steder")}>{t("Steder")}</a> {t("og")}
          <a href={url("/hendelser")}>{t("Tidslinje")}</a>.
        </p>
      </div>
    )}
    <section id="graf-detaljer" class="graf-detaljer" hidden aria-label={t("Valgt oppslag")}></section>
  </div>

  <script type="application/json" id="graf-data" set:html={JSON.stringify(graf)} />
</Base>

<style>
  [hidden] { display: none !important; }
  .graf-kontroller { padding: 1rem; border: 1px solid var(--kant); border-radius: var(--radius); background: var(--sot); }
  .visninger, .verktoy, .graf-status, .tegnforklaring { display: flex; flex-wrap: wrap; gap: .6rem; align-items: center; }
  .verktoy { margin-top: 1rem; align-items: end; }
  .verktoy label { flex: 1 1 15rem; min-width: 0; font-size: .8rem; color: var(--tekst-dempet); }
  .verktoy input, .verktoy select { display: block; width: 100%; min-width: 0; margin-top: .35rem; background: var(--sjo-dyp); color: var(--tekst); border: 1px solid var(--kant); border-radius: var(--radius); padding: .65rem; font: inherit; font-size: .95rem; }
  button { min-height: 42px; padding: .55rem .9rem; background: var(--tre); color: var(--tekst-dempet); border: 1px solid var(--kant); border-radius: var(--radius); font: inherit; font-size: .9rem; cursor: pointer; }
  button:hover, button[aria-pressed="true"] { color: var(--bronse-lys); border-color: var(--bronse); }
  button[aria-pressed="true"] { background: #c39b5a20; }
  button:focus-visible, input:focus-visible, select:focus-visible { outline: 2px solid var(--bronse-lys); outline-offset: 3px; }
  .graf-hjelp { margin: .8rem 0 0; color: var(--tekst-svak); font-size: .85rem; }
  .graf-status { justify-content: space-between; gap: .5rem 1rem; margin: 1rem 0; font-size: .85rem; color: var(--tekst-dempet); }
  .graf-status p { margin: 0; }
  .tegnforklaring span { display: inline-flex; align-items: center; gap: .4rem; }
  .prikk { width: 9px; height: 9px; border-radius: 50%; display: inline-block; }
  .prikk.karakterer { background: #c39b5a; }
  .prikk.steder { background: #7ba3a8; }
  .prikk.hendelser { background: #a4543f; }
  .graf-ramme { border: 1px solid var(--kant); border-radius: var(--radius); background: radial-gradient(ellipse at 50% 40%, var(--sot), var(--sjo-dyp) 75%); overflow: hidden; margin-bottom: 1rem; }
  #graf { display: block; width: 100%; height: min(68vh, 640px); touch-action: pan-y; }
  .graf-fallback { padding: 2rem 1.5rem; margin: 0; color: var(--tekst-svak); text-align: center; }
  .graf-ramme.klar .graf-fallback, .graf-ramme:not(.klar) #graf { display: none; }
  .graf-detaljer { padding: 1rem 1.25rem; margin-bottom: 2rem; border: 1px solid var(--kant); border-radius: var(--radius); background: var(--sot); }
  .graf-detaljer :global(h2) { margin: 0 0 .5rem; font-size: 1.35rem; }
  .graf-detaljer :global(ul) { display: flex; flex-wrap: wrap; gap: .5rem 1.2rem; padding: 0; list-style: none; }
  .graf-detaljer :global(p) { color: var(--tekst-dempet); }
  @media(max-width: 540px) { .visninger button { flex: 1 1 40%; } .verktoy button { width: 100%; } }
</style>

<script>
  const english = document.documentElement.lang === 'en';
  import { velgGraf, iVisning, type GrafNode as Node, type GrafKant as Kant, type Visning } from '../lib/grafutvalg';

  type Punkt = Node & { x: number; y: number; vx: number; vy: number; grad: number };

  const FARGE: Record<Node['samling'], string> = {
    karakterer: '#c39b5a',
    steder: '#7ba3a8',
    hendelser: '#a4543f',
  };
  const NS = 'http://www.w3.org/2000/svg';

  const dataTag = document.getElementById('graf-data');
  const svg = document.getElementById('graf') as SVGSVGElement | null;
  const ramme = svg?.closest('.graf-ramme');
  if (dataTag && svg && ramme) {
    const { noder, kanter } = JSON.parse(dataTag.textContent!) as {
      noder: Node[];
      kanter: Kant[];
    };

    const grad = new Map<string, number>();
    for (const n of noder) grad.set(n.id, 0);
    for (const k of kanter) {
      grad.set(k.fra, (grad.get(k.fra) ?? 0) + 1);
      grad.set(k.til, (grad.get(k.til) ?? 0) + 1);
    }

    // Naboliste, brukt til å lyse opp koblingene ved peking.
    const naboer = new Map<string, Set<string>>();
    for (const n of noder) naboer.set(n.id, new Set());
    for (const k of kanter) {
      naboer.get(k.fra)?.add(k.til);
      naboer.get(k.til)?.add(k.fra);
    }

    let bredde = svg.clientWidth || 900;
    let hoyde = svg.clientHeight || 600;

    // Startposisjoner i en spiral — samme resultat hver gang siden lastes.
    const allePunkter: Punkt[] = noder.map((n, i) => {
      const vinkel = i * 2.399963; // gyllen vinkel gir jevn spredning
      const r = Math.min(bredde, hoyde) * 0.36 * Math.sqrt((i + 1) / noder.length);
      return {
        ...n,
        x: bredde / 2 + Math.cos(vinkel) * r,
        y: hoyde / 2 + Math.sin(vinkel) * r,
        vx: 0,
        vy: 0,
        grad: grad.get(n.id) ?? 0,
      };
    });
    let punkter = allePunkter;
    let aktiveKanter = kanter;
    const kart = new Map(allePunkter.map((p) => [p.id, p]));
    const radius = (p: Punkt) => 6 + Math.min(p.grad, 8) * 1.15;

    // --- Tegn SVG-elementene én gang, oppdater posisjoner i løkka ---------
    const lag = { linjer: document.createElementNS(NS, 'g'), noder: document.createElementNS(NS, 'g') };
    lag.linjer.setAttribute('stroke-linecap', 'round');
    svg.append(lag.linjer, lag.noder);

    const linjer = kanter.map((k) => {
      const el = document.createElementNS(NS, 'line');
      el.setAttribute('stroke', '#55625f');
      el.setAttribute('stroke-width', '1');
      el.setAttribute('stroke-opacity', '0.55');
      lag.linjer.append(el);
      return { el, kant: k };
    });

    const tekstBredder = new Map<string, number>();
    const noderEl = allePunkter.map((p) => {
      const g = document.createElementNS(NS, 'g');
      g.setAttribute('tabindex', '0');
      g.setAttribute('role', 'button');
      g.setAttribute('aria-label', `${english ? 'Focus on' : 'Fokuser på'} ${p.tittel}`);
      g.dataset.samling = p.samling;
      g.style.touchAction = 'none';

      g.style.cursor = 'pointer';

      const sirkel = document.createElementNS(NS, 'circle');
      sirkel.setAttribute('r', String(radius(p)));
      sirkel.setAttribute('fill', FARGE[p.samling]);
      sirkel.setAttribute('stroke', '#0e1416');
      sirkel.setAttribute('stroke-width', '1.5');

      const tekst = document.createElementNS(NS, 'text');
      tekst.textContent = p.tittel;
      tekst.setAttribute('text-anchor', 'middle');
      tekst.setAttribute('y', String(radius(p) + 14));
      tekst.setAttribute('fill', '#e6e1d5');
      tekst.setAttribute('font-size', '11.5');
      tekst.setAttribute('font-family', 'system-ui, sans-serif');
      tekst.setAttribute('paint-order', 'stroke');
      tekst.setAttribute('stroke', '#0e1416');
      tekst.setAttribute('stroke-width', '3');
      tekst.style.pointerEvents = 'none';

      g.append(sirkel, tekst);
      lag.noder.append(g);
      tekstBredder.set(p.id, tekst.getComputedTextLength() / 2 + 8);

      const aapne = () => { fokusFelt.value = p.id; sokFelt.value = ''; oppdaterUtvalg(); };
      g.addEventListener('click', (e) => {
        if (!dro) aapne();
        e.stopPropagation();
      });
      g.addEventListener('keydown', (e) => {
        if (['Enter', ' '].includes((e as KeyboardEvent).key)) { e.preventDefault(); aapne(); }
      });
      g.addEventListener('pointerenter', () => marker(p.id));
      g.addEventListener('focus', () => marker(p.id));
      g.addEventListener('pointerleave', () => marker(null));
      g.addEventListener('blur', () => marker(null));
      g.addEventListener('pointerdown', (e) => start(e as PointerEvent, p));

      return { g, sirkel, tekst, punkt: p };
    });

    // --- Markering -------------------------------------------------------
    let markert: string | null = null;
    let sokeTreff: Set<string> | null = null;

    function marker(id: string | null) {
      markert = id;
      tegnStil();
    }

    function tegnStil() {
      const nabo = markert ? naboer.get(markert) ?? new Set<string>() : null;

      for (const { g, sirkel, punkt } of noderEl) {
        let dimmet = false;
        if (nabo) dimmet = punkt.id !== markert && !nabo.has(punkt.id);
        else if (sokeTreff) dimmet = !sokeTreff.has(punkt.id);

        g.setAttribute('opacity', dimmet ? '0.22' : '1');
        const fremhevet =
          punkt.id === markert || (!!sokeTreff && sokeTreff.has(punkt.id) && !nabo);
        sirkel.setAttribute('stroke', fremhevet ? '#f2d9a8' : '#0e1416');
        sirkel.setAttribute('stroke-width', fremhevet ? '2.5' : '1.5');
      }

      for (const { el, kant } of linjer) {
        const aktiv = markert
          ? kant.fra === markert || kant.til === markert
          : true;
        el.setAttribute('stroke-opacity', markert ? (aktiv ? '0.9' : '0.08') : '0.55');
        el.setAttribute('stroke', aktiv && markert ? '#c39b5a' : '#55625f');
      }
    }

    // --- Dra -------------------------------------------------------------
    let dratt: Punkt | null = null;
    let dro = false;
    let startPos = { x: 0, y: 0 };

    function pekerPos(e: PointerEvent) {
      const r = svg!.getBoundingClientRect();
      return { x: e.clientX - r.left, y: e.clientY - r.top };
    }

    function start(e: PointerEvent, p: Punkt) {
      e.preventDefault();
      dratt = p;
      dro = false;
      startPos = pekerPos(e);
      (e.currentTarget as SVGGElement).setPointerCapture(e.pointerId);
    }

    svg.addEventListener('pointermove', (e) => {
      if (!dratt) return;
      const { x, y } = pekerPos(e);
      if (!dro && Math.hypot(x - startPos.x, y - startPos.y) < 5) return;
      dro = true;
      dratt.x = x;
      dratt.y = y;
      dratt.vx = 0;
      dratt.vy = 0;
      varm = Math.max(varm, 0.35);
    });

    const slutt = () => {
      dratt = null;
      // Nullstilles etter klikkhåndteringen, så et dratt punkt ikke navigerer.
      setTimeout(() => (dro = false), 0);
    };
    svg.addEventListener('pointerup', slutt);
    svg.addEventListener('pointercancel', slutt);

    // --- Kraftsimulering -------------------------------------------------
    // Enkel fjær-og-frastøtningsmodell: kanter trekker sammen, alle noder
    // skyver hverandre fra seg, og alt trekkes svakt mot midten.
    let varm = 1;

    function steg() {
      const n = punkter.length;
      // Ideallengden skaleres etter hvor mye plass hver node har å boltre seg på,
      // med tak og gulv så små og store kart begge blir lesbare.
      const perNode = Math.sqrt((bredde * hoyde) / Math.max(n, 1));
      const idealLengde = Math.max(95, Math.min(170, perNode * 0.72));
      const frastot = idealLengde * idealLengde * 0.3;

      for (let i = 0; i < n; i++) {
        const a = punkter[i];
        for (let j = i + 1; j < n; j++) {
          const b = punkter[j];
          let dx = b.x - a.x;
          let dy = b.y - a.y;
          let d2 = dx * dx + dy * dy;
          if (d2 < 0.01) {
            dx = (i % 2 ? 1 : -1) * 0.7;
            dy = 0.7;
            d2 = 1;
          }
          const d = Math.sqrt(d2);
          const kraft = frastot / d2;
          const fx = (dx / d) * kraft;
          const fy = (dy / d) * kraft;
          a.vx -= fx;
          a.vy -= fy;
          b.vx += fx;
          b.vy += fy;

          // Reserve space for labels as well as the circles.
          const plassX = (tekstBredder.get(a.id) ?? 70) + (tekstBredder.get(b.id) ?? 70);
          const overlappX = plassX - Math.abs(dx);
          const overlappY = 44 - Math.abs(dy);
          if (overlappX > 0 && overlappY > 0) {
            if (overlappX < overlappY) {
              const skyv = Math.sign(dx || 1) * overlappX * .2;
              a.vx -= skyv; b.vx += skyv;
            } else {
              const skyv = Math.sign(dy || 1) * overlappY * .2;
              a.vy -= skyv; b.vy += skyv;
            }
          }
        }
      }

      for (const k of aktiveKanter) {
        const a = kart.get(k.fra);
        const b = kart.get(k.til);
        if (!a || !b) continue;
        const dx = b.x - a.x;
        const dy = b.y - a.y;
        const d = Math.hypot(dx, dy) || 0.01;
        const kraft = (d - idealLengde) * 0.055;
        const fx = (dx / d) * kraft;
        const fy = (dy / d) * kraft;
        a.vx += fx;
        a.vy += fy;
        b.vx -= fx;
        b.vy -= fy;
      }

      const midtX = bredde / 2;
      const midtY = hoyde / 2;
      for (const p of punkter) {
        p.vx += (midtX - p.x) * 0.0038;
        p.vy += (midtY - p.y) * 0.0038;

        if (p === dratt) {
          p.vx = 0;
          p.vy = 0;
          continue;
        }
        p.vx *= 0.86;
        p.vy *= 0.86;
        p.x += p.vx * varm;
        p.y += p.vy * varm;

        // Hold nodene innenfor lerretet, med plass til navnet under.
        const r = radius(p) + 4;
        const marg = Math.min(bredde / 2, Math.max(r + 10, tekstBredder.get(p.id) ?? 70));
        p.x = Math.max(marg, Math.min(bredde - marg, p.x));
        p.y = Math.max(r + 6, Math.min(hoyde - r - 16, p.y));
      }

      varm = Math.max(0.06, varm * 0.994);
    }

    function tegn() {
      for (const { el, kant } of linjer) {
        if (el.style.display === 'none') continue;
        const a = kart.get(kant.fra);
        const b = kart.get(kant.til);
        if (!a || !b) continue;
        el.setAttribute('x1', a.x.toFixed(1));
        el.setAttribute('y1', a.y.toFixed(1));
        el.setAttribute('x2', b.x.toFixed(1));
        el.setAttribute('y2', b.y.toFixed(1));
      }
      for (const { g, punkt } of noderEl) {
        if (g.style.display === 'none') continue;
        g.setAttribute('transform', `translate(${punkt.x.toFixed(1)} ${punkt.y.toFixed(1)})`);
      }
    }

    let kjorer = true;
    function loop() {
      if (kjorer) {
        steg();
        tegn();
      }
      requestAnimationFrame(loop);
    }

    // Pause når kartet er ute av syne, så det ikke tapper batteri.
    new IntersectionObserver(
      ([e]) => (kjorer = e.isIntersecting),
      { threshold: 0 }
    ).observe(svg);

    function malOpp() {
      bredde = svg!.clientWidth || bredde;
      const kolonner = Math.max(2, Math.floor(bredde / 170));
      const basisHoyde = Math.min(window.innerHeight * .68, 640);
      svg!.style.height = `${Math.max(basisHoyde, Math.ceil(punkter.length / kolonner) * 48 + 48)}px`;
      hoyde = svg!.clientHeight || hoyde;
      svg!.setAttribute('viewBox', `0 0 ${bredde} ${hoyde}`);
      varm = Math.max(varm, 0.5);
    }
    window.addEventListener('resize', malOpp);

    // --- Views, filtering and one-hop focus -----------------------------
    let visning: Visning = 'folk';
    const sokFelt = document.getElementById('graf-sok') as HTMLInputElement;
    const fokusFelt = document.getElementById('graf-fokus') as HTMLSelectElement;
    const antall = document.getElementById('graf-antall')!;
    const detaljer = document.getElementById('graf-detaljer')!;
    const knapper = [...document.querySelectorAll<HTMLButtonElement>('[data-visning]')];

    function fyllFokus() {
      const valgt = fokusFelt.value;
      fokusFelt.replaceChildren(new Option((english ? "Entire view":"Hele visningen"), ''));
      for (const n of noder.filter(n => iVisning(n, visning)).sort((a, b) => a.tittel.localeCompare(b.tittel, english ? 'en' : 'nb'))) {
        fokusFelt.add(new Option(n.tittel, n.id));
      }
      fokusFelt.value = [...fokusFelt.options].some(o => o.value === valgt) ? valgt : '';
    }

    function ordne() {
      punkter.forEach((p, i) => {
        const vinkel = i * 2.399963;
        const r = Math.min(bredde, hoyde) * .36 * Math.sqrt((i + 1) / punkter.length);
        p.x = bredde / 2 + Math.cos(vinkel) * r;
        p.y = hoyde / 2 + Math.sin(vinkel) * r;
        p.vx = p.vy = 0;
      });
      varm = 1;
    }

    function oppdaterUtvalg() {
      const utvalg = velgGraf(noder, kanter, visning, sokFelt.value, fokusFelt.value);
      const synlige = new Set(utvalg.noder.map(n => n.id));
      punkter = allePunkter.filter(p => synlige.has(p.id));
      aktiveKanter = utvalg.kanter;
      markert = null;
      sokeTreff = utvalg.treff.size ? utvalg.treff : null;
      grad.clear();
      for (const k of aktiveKanter) {
        grad.set(k.fra, (grad.get(k.fra) ?? 0) + 1);
        grad.set(k.til, (grad.get(k.til) ?? 0) + 1);
      }
      for (const { g, sirkel, tekst, punkt } of noderEl) {
        const vis = synlige.has(punkt.id);
        g.style.display = vis ? '' : 'none';
        g.setAttribute('tabindex', vis ? '0' : '-1');
        g.setAttribute('aria-pressed', String(punkt.id === fokusFelt.value));
        punkt.grad = grad.get(punkt.id) ?? 0;
        sirkel.setAttribute('r', String(radius(punkt)));
        tekst.setAttribute('y', String(radius(punkt) + 14));
      }
      for (const { el, kant } of linjer) el.style.display = synlige.has(kant.fra) && synlige.has(kant.til) ? '' : 'none';
      const fokus = noder.find(n => n.id === fokusFelt.value);
      const omfang = fokus ? ` · ${english ? 'Around' : 'Rundt'} ${fokus.tittel}` : sokFelt.value.trim() ? ` · ${utvalg.treff.size} ${english ? 'search results and their connections' : 'søketreff og deres forbindelser'}` : '';
      antall.textContent = `${punkter.length} ${english ? 'entries' : 'oppslag'} · ${aktiveKanter.length} ${english ? 'connections' : 'forbindelser'}${omfang}`;
      document.getElementById('graf-tom')!.hidden = punkter.length > 0;
      svg!.style.display = punkter.length ? '' : 'none';
      detaljer.replaceChildren();
      detaljer.hidden = !fokus;
      if (fokus) {
        const h = document.createElement('h2');
        const lenke = document.createElement('a');
        lenke.href = fokus.url;
        lenke.textContent = `${fokus.tittel} →`;
        h.append(lenke);
        const p = document.createElement('p');
        p.textContent = (english ? "Direct connections in this view. Open an entry to read more.":"Direkte forbindelser i denne visningen. Åpne et oppslag for å lese mer.");
        const liste = document.createElement('ul');
        for (const n of utvalg.noder.filter(n => n.id !== fokus.id).sort((a, b) => a.tittel.localeCompare(b.tittel, english ? 'en' : 'nb'))) {
          const li = document.createElement('li');
          const a = document.createElement('a');
          a.href = n.url;
          a.textContent = n.tittel;
          li.append(a); liste.append(li);
        }
        if (!liste.children.length) p.textContent = (english ? "No recorded connections in this view. Try including places or events.":"Ingen registrerte forbindelser i denne visningen. Prøv å ta med steder eller hendelser.");
        detaljer.append(h, p, liste);
      }
      for (const knapp of knapper) knapp.setAttribute('aria-pressed', String(knapp.dataset.visning === visning));
      for (const forklaring of document.querySelectorAll<HTMLElement>('[data-forklaring]')) {
        forklaring.hidden = visning !== 'alt' && visning !== forklaring.dataset.forklaring;
      }
      malOpp();
      ordne();
      tegnStil();
      tegn();
    }

    for (const knapp of knapper) knapp.addEventListener('click', () => {
      visning = knapp.dataset.visning as Visning;
      fyllFokus();
      oppdaterUtvalg();
    });
    sokFelt.addEventListener('input', () => { fokusFelt.value = ''; oppdaterUtvalg(); });
    fokusFelt.addEventListener('change', () => { sokFelt.value = ''; oppdaterUtvalg(); });
    document.getElementById('graf-nullstill')?.addEventListener('click', () => {
      visning = 'folk'; sokFelt.value = ''; fokusFelt.value = '';
      fyllFokus(); oppdaterUtvalg();
    });

    ramme.classList.add('klar');
    malOpp();
    fyllFokus();
    oppdaterUtvalg();
    loop();
  }
</script>
