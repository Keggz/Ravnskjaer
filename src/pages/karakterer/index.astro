---
import Base from '../../layouts/Base.astro';
import Oversikt from '../../components/Oversikt.astro';
import { hentSamling } from '../../lib/bibliotek';

const oppslag = await hentSamling('karakterer');
---

<Base tittel="Folk">
  <Oversikt
    stikk="Bibliotek"
    tittel="Folk i og rundt Ravnskjær"
    ingress="Spillerkarakterer, høvdinger, handelsfolk og alle andre som har satt spor. Klikk deg inn for å se hvem de kjenner og hva de har vært med på."
    oppslag={oppslag}
    sokeHint="Søk på navn, rolle eller slekt …"
  />
</Base>
