---
import { languageFor, translate } from '../../lib/i18n';
import Base from '../../layouts/Base.astro';
import Oversikt from '../../components/Oversikt.astro';
import { hentSamling } from '../../lib/bibliotek';
const lang = languageFor(Astro.url.pathname);
const t = (text: string) => translate(text, lang);

const oppslag = await hentSamling('karakterer', lang);
---

<Base tittel={t("Folk")}>
  <Oversikt
    stikk={t("Bibliotek")}
    tittel={t("Folk i og rundt Ravnskjær")}
    ingress={t("Spillerkarakterer, høvdinger, handelsfolk og alle andre som har satt spor. Klikk deg inn for å se hvem de kjenner og hva de har vært med på.")}
    filtertype="karakterer"
    oppslag={oppslag}
    sokeHint={t("Søk på navn, rolle eller slekt …")}
  />
</Base>
