---
import Base from '../layouts/Base.astro';
import { hentSamling, koblingerFor } from '../lib/bibliotek';

const folk = await hentSamling('karakterer');
const familietyper = new Set(['far', 'mor', 'barn', 'gift med', 'adoptivfar', 'adoptivsønn', 'tante', 'niese', 'bror', 'søster', 'eldre bror', 'yngre bror', 'partner']);
const aetter = [...new Set(folk.map(p => p.data.tilhorighet).filter(Boolean))].sort((a, b) => a.localeCompare(b, 'nb'));
const farger = ['#c39b5a', '#7ba3a8', '#b59ac6', '#9eaf81', '#ce9d88'];
const grupper = [...aetter, 'Uten oppgitt ætt'].map((navn, index) => ({
  navn, id: 'aett-' + index, farge: farger[index % farger.length],
  personer: folk.filter(p => (p.data.tilhorighet || 'Uten oppgitt ætt') === navn).map(p => ({
    ...p, band: koblingerFor(p.nokkel, folk).filter(k => familietyper.has(k.type.toLocaleLowerCase('nb'))),
  })),
})).filter(g => g.personer.length);
---

<Base tittel="Slekt" beskrivelse="Ættene i Ravnskjær, med familie, ekteskap og slektsbånd.">
  <div class="innhold slekt">
    <div class="sidetopp">
      <p class="stikk">Folk og tilhørighet</p>
      <h1>Ættene i Ravnskjær</h1>
      <p class="ingress">Familiene, menneskene og båndene mellom dem. Velg en ætt eller følg et navn for å lese videre.</p>
    </div>
    <nav class="aettvalg" aria-label="Hopp til ætt">
      {grupper.map(g => <a href={'#' + g.id} style={`--aett:${g.farge}`}>{g.navn}<span>{g.personer.length}</span></a>)}
    </nav>
    <div class="familier">
      {grupper.map(g => (
        <section id={g.id} class="familie" style={`--aett:${g.farge}`} aria-labelledby={g.id + '-tittel'}>
          <header class="familiehode">
            <p class="stikk">{g.navn === 'Uten oppgitt ætt' ? 'Andre forbindelser' : 'Familie og tilhørighet'}</p>
            <h2 id={g.id + '-tittel'}>{g.navn}</h2>
            <p>{g.personer.length} {g.personer.length === 1 ? 'person' : 'personer'}</p>
          </header>
          <ul class="personer">
            {g.personer.map(p => (
              <li class="person">
                <div class="personhode">
                  <a class="navn" href={p.url}>{p.tittel}</a>
                  <div class="merker">
                    {p.data.spillerkarakter && <span>Spillerkarakter</span>}
                    {p.data.status === 'død' && <span class="dod">Død</span>}
                  </div>
                </div>
                <p class="rolle">{[p.data.rolle, p.data.levetid].filter(Boolean).join(' · ')}</p>
                {p.band.length ? (
                  <ul class="band" aria-label={'Familiebånd for ' + p.tittel}>
                    {p.band.map(b => <li><span>{b.type}</span><a href={b.motpart.url}>{b.motpart.tittel}</a></li>)}
                  </ul>
                ) : <p class="ukjent">Ingen familiebånd er ført opp ennå.</p>}
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </div>
</Base>

<style>
  .slekt { padding-bottom: 2rem; }
  .aettvalg { display: flex; flex-wrap: wrap; gap: .6rem; margin-bottom: 2rem; }
  .aettvalg a { display: flex; gap: .7rem; align-items: center; padding: .5rem .8rem; border: 1px solid var(--kant); border-left: 3px solid var(--aett); border-radius: 5px; text-decoration: none; color: var(--tekst); background: var(--sot); font-size: .85rem; min-height: 44px; }
  .aettvalg span { color: var(--tekst-dempet); }
  .familier { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; align-items: start; }
  .familie { min-width: 0; border: 1px solid var(--kant); border-top: 3px solid var(--aett); background: var(--sot); border-radius: 8px; scroll-margin-top: 9rem; }
  .familiehode { padding: 1.5rem; background: linear-gradient(140deg, var(--tre), transparent); border-bottom: 1px solid var(--kant); }
  .familiehode .stikk { color: var(--aett); font-size: .65rem; margin-bottom: .6rem; }
  .familiehode h2 { font-size: 1.6rem; margin-bottom: .3rem; }
  .familiehode > p:last-child { color: var(--tekst-dempet); font-size: .8rem; margin: 0; }
  .personer, .band { list-style: none; margin: 0; padding: 0; }
  .person { padding: 1.1rem 1.5rem; }
  .person + .person { border-top: 1px solid var(--kant); }
  .personhode { display: flex; gap: .5rem; flex-wrap: wrap; align-items: baseline; justify-content: space-between; }
  .navn { font: 1.1rem var(--serif); color: var(--tekst); text-decoration: none; line-height: 1.5; }
  a:hover { color: var(--bronse-lys); }
  a:focus-visible { outline: 2px solid var(--aett, var(--bronse-lys)); outline-offset: 3px; }
  .merker { display: flex; flex-wrap: wrap; gap: .3rem; font-size: .65rem; color: var(--bronse-lys); }
  .merker span { padding: .05rem .4rem; border: 1px solid var(--kant); border-radius: 3px; }
  .merker .dod { color: var(--tekst-dempet); }
  .rolle { color: var(--tekst-dempet); font-size: .8rem; margin: .25rem 0 .75rem; }
  .band { display: grid; gap: .4rem; border-left: 1px solid var(--aett); padding-left: .8rem; }
  .band li { display: flex; flex-wrap: wrap; column-gap: .6rem; font-size: .85rem; }
  .band span { color: var(--tekst-dempet); min-width: 4.6rem; }
  .band a { text-decoration-color: var(--kant); }
  .ukjent { font-size: .8rem; color: var(--tekst-dempet); margin: 0; }
  .slekt :is(h2, a, p, span) { overflow-wrap: anywhere; }
  @media (max-width: 760px) { .familier { grid-template-columns: minmax(0, 1fr); } .familiehode, .person { padding: 1rem; } }
</style>
