---
import { languageFor, translate } from '../../lib/i18n';
import { getCollection } from 'astro:content';
import { renderTranslated } from '../../lib/translated-content';
import Oppslag from '../../layouts/Oppslag.astro';
import { hentAlle, koblingerFor } from '../../lib/bibliotek';
const lang = languageFor(Astro.url.pathname);
const t = (text: string) => translate(text, lang);

export async function getStaticPaths() {
  const entries = await getCollection('steder', ({ data }) => !data.skjult);
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await renderTranslated(entry, lang);

const alle = await hentAlle(lang);
const oppslag = alle.find((o) => o.nokkel === `steder/${entry.id}`)!;
const koblinger = koblingerFor(oppslag.nokkel, alle);
---

<Oppslag oppslag={oppslag} koblinger={koblinger} tilbakeUrl="/steder" tilbakeNavn={t("Alle steder")}>
  <Content />
</Oppslag>
