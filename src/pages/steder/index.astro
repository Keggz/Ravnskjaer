---
import Base from '../../layouts/Base.astro';
import Oversikt from '../../components/Oversikt.astro';
import { hentSamling } from '../../lib/bibliotek';

const oppslag = await hentSamling('steder');
---

<Base tittel="Steder">
  <Oversikt
    stikk="Bibliotek"
    tittel="Steder i og utenfor Ravnskjær"
    ingress="Hjemstedet, nabobygdene og reisemålene over havet. Finn steder etter navn eller type, og følg forbindelsene til folkene som hører til der."
    filtertype="steder"
    oppslag={oppslag}
    sokeHint="Søk på stedsnavn eller type …"
  />
</Base>
