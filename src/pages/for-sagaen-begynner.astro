---
import Base from '../layouts/Base.astro';
---
<Base tittel="Før sagaen begynner" beskrivelse="Lydprologen spillerne fikk før den første spilleøkten i Ravnskjær.">
  <article class="innhold smal prolog">
    <a href="/">← Til Ravnskjær</a>
    <header class="sidetopp">
      <p class="stikk">En lydprolog · 3 minutter og 36 sekunder</p>
      <h1>Før sagaen begynner</h1>
      <p class="ingress">Før den første spilleøkten fikk spillerne dette lydklippet for å tre inn i stemningen i Ravnskjær.</p>
    </header>
    <figure>
      <figcaption id="lydtittel">Lytt til den opprinnelige introduksjonen</figcaption>
      <audio controls preload="none" aria-labelledby="lydtittel">
        <source src="/media/lyd/ravnskjaer-prolog.mp3" type="audio/mpeg" />
        Nettleseren din støtter ikke lydavspilling. <a href="/media/lyd/ravnskjaer-prolog.mp3">Åpne lydfilen</a>.
      </audio>
      <p>Trykk på avspillingsknappen når du er klar.</p>
    </figure>
    <p>Dette er inngangen til spillet slik den ble delt før historien begynte. Selve hendelsene finner du i krøniken.</p>
    <nav aria-label="Videre inn i fortellingen">
      <a href="/hendelser/sommerlekene-og-steinen">Begynn med sommerlekene →</a>
      <a href="/hendelser">Se hele tidslinjen →</a>
      <a href="/drommer-og-varsler">Drømmer og varsler →</a>
    </nav>
  </article>
</Base>
<style>
  .prolog { padding-top: 2rem; padding-bottom: 4rem; }
  figure { margin: 0 0 2rem; padding: clamp(1rem, 4vw, 2rem); border: 1px solid var(--kant); border-radius: var(--radius); background: var(--sot); }
  figcaption { color: var(--bronse-lys); margin-bottom: 1rem; font-family: var(--serif); font-size: 1.2rem; }
  audio { display: block; width: 100%; }
  figure p { margin: 1rem 0 0; color: var(--tekst-dempet); font-size: .9rem; }
  nav { display: flex; flex-wrap: wrap; gap: .75rem 1.5rem; }
</style>
