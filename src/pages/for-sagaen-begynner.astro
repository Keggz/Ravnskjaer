---
import { languageFor, localUrl, translate } from '../lib/i18n';
import Base from '../layouts/Base.astro';
const lang = languageFor(Astro.url.pathname);
const t = (text: string) => translate(text, lang);
const url = (path: string) => localUrl(path, lang);
---
<Base tittel={t("Før sagaen begynner")} beskrivelse={t("Lydprologen spillerne fikk før den første spilleøkten i Ravnskjær.")}>
  <article class="innhold smal prolog">
    <a href={url("/")}>{t("← Til Ravnskjær")}</a>
    <header class="sidetopp">
      <p class="stikk">{t("En lydprolog · 3 minutter og 36 sekunder")}</p>
      <h1>{t("Før sagaen begynner")}</h1>
      <p class="ingress">{t("Før den første spilleøkten fikk spillerne dette lydklippet for å tre inn i stemningen i Ravnskjær.")}</p>
    </header>
    {lang === 'en' && <p class="ingress">The recording is presented in its original form.</p>}
    <figure>
      <figcaption id="lydtittel">{t("Lytt til den opprinnelige introduksjonen")}</figcaption>
      <audio controls preload="none" aria-labelledby="lydtittel">
        <source src="/media/lyd/ravnskjaer-prolog.mp3" type="audio/mpeg" />
        {t("Nettleseren din støtter ikke lydavspilling.")} <a href={url("/media/lyd/ravnskjaer-prolog.mp3")}>{t("Åpne lydfilen")}</a>.
      </audio>
      <p>{t("Trykk på avspillingsknappen når du er klar.")}</p>
    </figure>
    <p>{t("Dette er inngangen til spillet slik den ble delt før historien begynte. Selve hendelsene finner du i krøniken.")}</p>
    <nav aria-label={t("Videre inn i fortellingen")}>
      <a href={url("/hendelser/sommerlekene-og-steinen")}>{t("Begynn med sommerlekene →")}</a>
      <a href={url("/hendelser")}>{t("Se hele tidslinjen →")}</a>
      <a href={url("/drommer-og-varsler")}>{t("Drømmer og varsler →")}</a>
    </nav>
  </article>
</Base>
<style>
  .prolog { padding-top: 2rem; padding-bottom: 4rem; }
  figure { margin: 0 0 2rem; padding: clamp(1rem, 4vw, 2rem); border: 1px solid var(--kant); border-radius: var(--radius); background: var(--sot); }
  figcaption { color: var(--bronse-lys); margin-bottom: 1rem; font-family: var(--serif); font-size: 1.2rem; }
  audio { display: block; width: 100%; }
  figure p { margin: 1rem 0 0; color: var(--tekst-dempet); font-size: .9rem; }
  nav { display: flex; flex-wrap: wrap; gap: .75rem 1.5rem; }
</style>
