---
import { languageFor, localUrl, translate } from '../lib/i18n';
import Base from '../layouts/Base.astro';
const lang = languageFor(Astro.url.pathname);
const t = (text: string) => translate(text, lang);
const url = (path: string) => localUrl(path, lang);
---

<Base tittel={t("Ikke funnet")} beskrivelse={t("Denne siden finnes ikke i biblioteket.")}>
  <div class="innhold smal">
    <div class="borte">
      <p class="stikk">{t("Fire hundre og fire")}</p>
      <h1>{t("Her er det ingenting")}</h1>
      <p class="ingress">
        {t("Enten er adressen skrevet feil, eller så er dette noe høvdingen ennå ikke har sluppet ut i lyset.")}
      </p>

      <nav class="veier" aria-label={t("Videre")}>
        <a href={url("/")}>{t("Til forsiden")}</a>
        <a href={url("/karakterer")}>{t("Folk")}</a>
        <a href={url("/steder")}>{t("Steder")}</a>
        <a href={url("/penumbra")}>Penumbra</a>
        <a href={url("/hendelser")}>{t("Tidslinje")}</a>
      </nav>
    </div>
  </div>
</Base>

<style>
  .borte {
    padding: 5rem 0 3rem;
  }
  .stikk {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--bronse);
    margin-bottom: 0.8rem;
  }
  .ingress {
    color: var(--tekst-dempet);
    font-family: var(--serif);
    font-size: 1.12rem;
    max-width: 32rem;
  }
  .veier {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 2rem;
  }
  .veier a {
    padding: 0.5rem 0.9rem;
    background: var(--sot);
    border: 1px solid var(--kant);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--tekst-dempet);
    font-size: 0.92rem;
  }
  .veier a:hover {
    border-color: var(--kant-sterk);
    color: var(--bronse-lys);
  }
</style>
