---
import Base from '../layouts/Base.astro';
import Kartgrunn from '../components/Kartgrunn.astro';
import { hentSamling } from '../lib/bibliotek';

const steder = await hentSamling('steder');
const plassert = steder.filter((s) => s.data.kart);
const uplassert = steder.filter((s) => !s.data.kart);
---

<Base
  tittel="Kart"
  beskrivelse="Kart over Ravnskjær — fjorden, havna, hallen og landet omkring."
>
  <div class="innhold">
    <div class="sidetopp">
      <p class="stikk">Bibliotek</p>
      <h1>Ravnskjær og fjorden</h1>
      <p class="ingress">
        Slik ligger landet. Hold musa over et navn for å se hva stedet er, og
        klikk for å åpne oppslaget.
      </p>
    </div>
  </div>

  <div class="kart-rull">
    <div class="kart-ramme" id="kart-ramme">
      <Kartgrunn />

      <div class="markorer">
        {plassert.map((s) => (
          <a
            href={s.url}
            class="markor"
            data-side={s.data.kart.side}
            style={`left:${s.data.kart.x}%; top:${s.data.kart.y}%`}
          >
            <span class="pigg" aria-hidden="true"></span>
            <span class="lapp">
              <span class="lapp-navn">{s.tittel}</span>
              <span class="lapp-kort">{s.kort}</span>
            </span>
          </a>
        ))}
      </div>

      <output class="avlesning" id="kart-avlesning" hidden></output>
    </div>
  </div>

  <div class="innhold">
    <div class="under-kart">
      <button type="button" id="kart-koordinater" aria-pressed="false">
        Finn koordinater
      </button>
      <p class="hjelp">
        Skru på og klikk i kartet — da får du <code>kart:</code>-linjene å lime
        inn øverst i stedsfilen.
      </p>
    </div>

    {uplassert.length > 0 && (
      <section class="uplassert">
        <h2>Ikke satt på kartet ennå</h2>
        <ul>
          {uplassert.map((s) => (
            <li>
              <a href={s.url}>
                <span class="navn">{s.tittel}</span>
                {s.data.stedstype && <span class="type">{s.data.stedstype}</span>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</Base>

<style>
  /* Kartet har fast forhold mellom bredde og høyde, så markørene i prosent
     treffer samme punkt uansett skjermbredde. */
  .kart-rull {
    overflow-x: auto;
    border-top: 1px solid var(--kant);
    border-bottom: 1px solid var(--kant);
  }
  .kart-ramme {
    position: relative;
    aspect-ratio: 1000 / 640;
    min-width: 640px;
    max-width: 1200px;
    margin: 0 auto;
  }
  .kart-ramme.leser {
    cursor: crosshair;
  }

  .markorer {
    position: absolute;
    inset: 0;
  }

  .markor {
    position: absolute;
    transform: translate(-50%, -50%);
    display: grid;
    justify-items: center;
    gap: 3px;
    text-decoration: none;
    color: inherit;
    z-index: 1;
  }
  .markor:hover,
  .markor:focus-visible {
    z-index: 3;
  }

  .pigg {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--bronse);
    border: 2px solid var(--sjo-dyp);
    box-shadow: 0 0 0 1px rgba(195, 155, 90, 0.45);
    transition: transform 0.15s ease, background 0.15s ease;
  }
  .markor:hover .pigg,
  .markor:focus-visible .pigg {
    background: var(--bronse-lys);
    transform: scale(1.35);
  }

  .lapp {
    position: relative;
    display: grid;
    justify-items: center;
    pointer-events: none;
  }
  .lapp-navn {
    font-family: var(--serif);
    font-size: 0.95rem;
    line-height: 1.15;
    white-space: nowrap;
    color: var(--tekst);
    text-shadow: 0 0 4px var(--sjo-dyp), 0 0 8px var(--sjo-dyp),
      0 1px 2px var(--sjo-dyp);
  }
  .markor:hover .lapp-navn,
  .markor:focus-visible .lapp-navn {
    color: var(--bronse-lys);
  }

  /* Selve beskrivelsen kommer først når du peker. Den ligger absolutt
     plassert, ellers ville den skjøvet navnet vekk fra prikken sin. */
  .lapp-kort {
    position: absolute;
    top: calc(100% + 5px);
    left: 50%;
    transform: translateX(-50%);
    width: max-content;
    max-width: 17rem;
    padding: 0.45rem 0.6rem;
    background: var(--sot);
    border: 1px solid var(--kant-sterk);
    border-radius: var(--radius);
    font-size: 0.82rem;
    line-height: 1.4;
    color: var(--tekst-dempet);
    text-align: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.15s ease;
  }
  .markor:hover .lapp-kort,
  .markor:focus-visible .lapp-kort {
    opacity: 1;
    visibility: visible;
  }

  /* Navnet legger seg dit `side` peker, så tette steder ikke skygger for hverandre. */
  .markor[data-side='over'] {
    grid-auto-flow: row;
  }
  .markor[data-side='over'] .lapp {
    order: -1;
  }
  .markor[data-side='venstre'],
  .markor[data-side='hoyre'] {
    grid-auto-flow: column;
    align-items: center;
  }
  .markor[data-side='venstre'] .lapp {
    order: -1;
  }

  .avlesning {
    position: absolute;
    left: 50%;
    bottom: 0.75rem;
    transform: translateX(-50%);
    z-index: 5;
    padding: 0.5rem 0.75rem;
    background: var(--sot);
    border: 1px solid var(--bronse);
    border-radius: var(--radius);
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 0.82rem;
    color: var(--tekst);
    white-space: pre;
  }

  .under-kart {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    flex-wrap: wrap;
    padding: 1.1rem 0 0;
  }
  .under-kart button {
    padding: 0.42rem 0.8rem;
    background: var(--tre);
    color: var(--tekst-dempet);
    border: 1px solid var(--kant);
    border-radius: var(--radius);
    font: inherit;
    font-size: 0.88rem;
    cursor: pointer;
  }
  .under-kart button:hover {
    color: var(--tekst);
    border-color: var(--kant-sterk);
  }
  .under-kart button[aria-pressed='true'] {
    color: var(--bronse-lys);
    border-color: var(--bronse);
  }
  .hjelp {
    margin: 0;
    font-size: 0.88rem;
    color: var(--tekst-svak);
  }

  .uplassert {
    margin-top: 2.5rem;
  }
  .uplassert h2 {
    font-family: var(--sans);
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--bronse);
    font-weight: 600;
    margin-bottom: 0.8rem;
  }
  .uplassert ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .uplassert a {
    display: flex;
    flex-direction: column;
    padding: 0.5rem 0.85rem;
    background: var(--sot);
    border: 1px solid var(--kant);
    border-radius: var(--radius);
    text-decoration: none;
    color: inherit;
  }
  .uplassert a:hover {
    border-color: var(--kant-sterk);
  }
  .uplassert .navn {
    font-family: var(--serif);
  }
  .uplassert a:hover .navn {
    color: var(--bronse-lys);
  }
  .uplassert .type {
    font-size: 0.76rem;
    color: var(--tekst-svak);
  }
</style>

<script>
  // Hjelpemiddel for deg som fyller kartet: klikk et punkt og få linjene
  // du skal lime inn i stedsfilen.
  const ramme = document.getElementById('kart-ramme');
  const knapp = document.getElementById('kart-koordinater');
  const avlesning = document.getElementById('kart-avlesning');

  if (ramme && knapp && avlesning) {
    let leser = false;

    knapp.addEventListener('click', () => {
      leser = !leser;
      knapp.setAttribute('aria-pressed', String(leser));
      ramme.classList.toggle('leser', leser);
      avlesning.hidden = true;
    });

    ramme.addEventListener('click', (e) => {
      if (!leser) return;
      // Hindrer at klikket åpner stedet man tilfeldigvis traff.
      e.preventDefault();

      const boks = ramme.getBoundingClientRect();
      const x = ((e.clientX - boks.left) / boks.width) * 100;
      const y = ((e.clientY - boks.top) / boks.height) * 100;

      avlesning.textContent = `kart: { x: ${x.toFixed(1)}, y: ${y.toFixed(1)} }`;
      avlesning.hidden = false;
    });
  }
</script>
