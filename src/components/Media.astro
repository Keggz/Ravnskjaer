---
interface Props {
  galleri?: { src: string; tekst?: string }[];
  video?: string;
  plakat?: string;
  tittel?: string;
  tekst?: string;
}
const { galleri = [], video, plakat, tittel, tekst } = Astro.props;

/** Gjør en YouTube- eller Vimeo-lenke om til en innbyggbar adresse. */
function bygg(url: string): { type: 'ramme' | 'fil'; src: string } {
  const yt = url.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/))([\w-]{11})/);
  if (yt) return { type: 'ramme', src: `https://www.youtube-nocookie.com/embed/${yt[1]}` };
  const vimeo = url.match(/vimeo\.com\/(\d+)/);
  if (vimeo) return { type: 'ramme', src: `https://player.vimeo.com/video/${vimeo[1]}` };
  return { type: 'fil', src: url };
}

const v = video ? bygg(video) : null;
---

{v && (
  <figure class="video">
    {tittel && <h2>{tittel}</h2>}
    {v.type === 'ramme' ? (
      <iframe
        src={v.src}
        title={tittel ?? "Video"}
        loading="lazy"
        allow="accelerometer; clipboard-write; encrypted-media; picture-in-picture"
        allowfullscreen
      />
    ) : (
      <video src={v.src} poster={plakat} aria-label={tittel ?? "Video"} controls preload="none" playsinline />
    )}
    {tekst && <figcaption>{tekst}</figcaption>}
  </figure>
)}

{galleri.length > 0 && (
  <div class="galleri">
    {galleri.map((b) => (
      <figure>
        <img src={b.src} alt={b.tekst ?? ''} loading="lazy" />
        {b.tekst && <figcaption>{b.tekst}</figcaption>}
      </figure>
    ))}
  </div>
)}

<style>
  .video { margin: 2rem 0; padding: 1.25rem; border: 1px solid var(--kant); border-radius: var(--radius); background: var(--sot); }
  .video h2 { margin: 0 0 1rem; font-size: 1.3rem; }
  .video iframe { display: block; width: 100%; aspect-ratio: 16 / 9; border: 0; }
  .video video { display: block; width: 100%; max-width: 26rem; max-height: 72vh; aspect-ratio: auto; object-fit: contain; margin: 0 auto; background: #000; }
  .video figcaption { margin-top: 1rem; color: var(--tekst-dempet); font-size: .9rem; }
  @media(max-width: 500px) { .video { padding: .8rem; } }
  .galleri {
    margin: 2rem 0;
    display: grid;
    gap: 0.9rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
  }
  .galleri figure {
    margin: 0;
  }
  .galleri img {
    width: 100%;
    border: 1px solid var(--kant);
    border-radius: var(--radius);
    background: var(--tre);
  }
  .galleri figcaption {
    margin-top: 0.45rem;
    font-size: 0.83rem;
    color: var(--tekst-svak);
    line-height: 1.5;
  }
</style>
