---
import { languageFor, localUrl, translate } from '../lib/i18n';
import type { Oppslag } from '../lib/bibliotek';
const lang = languageFor(Astro.url.pathname);
const t = (text: string) => translate(text, lang);
const url = (path: string) => localUrl(path, lang);

interface Props {
  oppslag: Oppslag;
}
const { oppslag } = Astro.props;
const d = oppslag.data;
const karaktertype = oppslag.samling === 'karakterer' ? (d.spillerkarakter ? t('Spillerkarakter') : 'NPC') : '';
const sokeTekst = [oppslag.tittel, oppslag.kort, oppslag.undertekst, d.tilhorighet ?? '', karaktertype, ...oppslag.merker]
  .join(' ')
  .toLowerCase();
---

<li data-sok={sokeTekst} data-samling={oppslag.samling} data-navn={oppslag.tittel} data-spiller={String(!!d.spillerkarakter)} data-status={d.status} data-aett={d.tilhorighet ?? ''} data-stedstype={d.stedstype}>
  <a href={url(oppslag.url)} class:list={["kort", { "kort--karakter": oppslag.samling === "karakterer" }]}>
    {oppslag.bilde ? (
      <img src={oppslag.bilde} alt="" class="kort-bilde" loading="lazy" />
    ) : (
      <div class="kort-tom" aria-hidden="true">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
          <path d="M12 2v20M2 12h20" />
        </svg>
      </div>
    )}
    <div class="kort-kropp">
      <span class="kort-meta">{oppslag.undertekst}</span>
      <span class="kort-tittel">{oppslag.tittel}</span>
      <p class="kort-kort">{oppslag.kort}</p>
      {(karaktertype || d.status === 'død') && (
        <div class="etiketter" style="margin-top:.45rem">
          {karaktertype && <span class:list={["etikett", d.spillerkarakter ? "etikett--spiller" : "etikett--npc"]}>{karaktertype}</span>}
          {d.status === 'død' && <span class="etikett etikett--dod">{t("Død")}</span>}
        </div>
      )}
    </div>
  </a>
</li>
