---
import { languageFor, localUrl, translate } from '../lib/i18n';
import { penumbraUrl } from '../lib/penumbra';
import Base from './Base.astro';
import { getCollection } from 'astro:content';
import Relasjoner from '../components/Relasjoner.astro';
import Media from '../components/Media.astro';
import type { Kobling, Oppslag } from '../lib/bibliotek';
const lang = languageFor(Astro.url.pathname);
const t = (text: string) => translate(text, lang);
const url = (path: string) => localUrl(path, lang);

interface Props {
  oppslag: Oppslag;
  koblinger: Kobling[];
  tilbakeUrl: string;
  tilbakeNavn: string;
}
const { oppslag, koblinger, tilbakeUrl, tilbakeNavn } = Astro.props;
const d = oppslag.data;
const forteller = koblinger.find(k => k.motpart.nokkel === d.forteller)?.motpart;
const andreSiden = await getCollection('penumbra', ({ data }) => !data.skjult && data.forbindelser.includes(oppslag.nokkel));
---

<Base tittel={oppslag.tittel} beskrivelse={oppslag.kort}>
  <article class="innhold smal">
    <a href={url(tilbakeUrl)} class="tilbake">← {t(tilbakeNavn)}</a>

    <header class="hode">
      <p class="stikk">{oppslag.undertekst}</p>
      <h1>{oppslag.tittel}</h1>
      <p class="ingress">{oppslag.kort}</p>
      {forteller && <p class="forteller">{t("Nedtegnet av")} <a href={url(forteller.url)}>{forteller.tittel}</a></p>}

      <div class="etiketter" style="margin-top:1.1rem">
        {oppslag.samling === "karakterer" && <span class:list={["etikett", d.spillerkarakter ? "etikett--spiller" : "etikett--npc"]}>{t(d.spillerkarakter ? "Spillerkarakter" : "NPC")}</span>}
        {d.status === 'død' && <span class="etikett etikett--dod">{t("Død")}</span>}
        {d.status === 'savnet' && <span class="etikett">{t("Savnet")}</span>}
        {d.tilhorighet && <span class="etikett">{d.tilhorighet}</span>}
        {d.kapittel && <span class="etikett">{d.kapittel}</span>}
        {oppslag.merker.map((m: string) => <span class="etikett">{m}</span>)}
      </div>
    </header>

    {oppslag.bilde && (
      <img src={oppslag.bilde} alt={oppslag.tittel} class:list={["hovedbilde", { portrett: oppslag.samling === "karakterer" }]} />
    )}

    <div class="brodtekst">
      <slot />
    </div>

    <Media galleri={d.galleri} video={d.video} plakat={d.video_plakat} tittel={d.video_tittel} tekst={d.video_tekst} />

    <Relasjoner koblinger={koblinger} />
    {andreSiden.length > 0 && <section class="andre-siden"><h2>{t("På den andre siden")}</h2><ul>{andreSiden.map(p => <li><a href={url(penumbraUrl(p))}>{t(p.data.tittel)}</a></li>)}</ul></section>}

    <slot name="etter" />
  </article>
</Base>

<style>
  .forteller { margin-top: 1rem; color: var(--tekst-dempet); font-size: .88rem; }
  .andre-siden { margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--kant); }
  .tilbake {
    display: inline-block;
    margin-top: 2.25rem;
    font-size: 0.88rem;
    color: var(--tekst-dempet);
    text-decoration: none;
  }
  .tilbake:hover {
    color: var(--bronse-lys);
  }
  .hode {
    padding: 1.25rem 0 1.75rem;
  }
  .stikk {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--bronse);
    margin-bottom: 0.6rem;
  }
  .ingress {
    color: var(--tekst-dempet);
    font-size: 1.12rem;
    font-family: var(--serif);
    margin: 0;
  }
  .hovedbilde {
    width: 100%;
    aspect-ratio: 21 / 9;
    object-fit: cover;
    border: 1px solid var(--kant);
    border-radius: var(--radius);
    margin-bottom: 2.25rem;
  }
  .hovedbilde.portrett {
    float: left;
    width: min(42%, 18rem);
    height: auto;
    aspect-ratio: auto;
    object-fit: contain;
    margin: .3rem 1.75rem 1.5rem 0;
  }
  .brodtekst::after { content: ''; display: block; clear: both; }
  @media (max-width: 600px) {
    .hovedbilde.portrett { float: none; display: block; width: min(100%, 20rem); margin: 0 auto 1.75rem; }
  }
  .brodtekst :global(h2) {
    margin-top: 2.25rem;
  }
  .brodtekst :global(h3) {
    margin-top: 1.75rem;
  }
  .brodtekst :global(ul),
  .brodtekst :global(ol) {
    padding-left: 1.3rem;
  }
  .brodtekst :global(li) {
    margin-bottom: 0.4rem;
  }
  .brodtekst :global(img) {
    border: 1px solid var(--kant);
    border-radius: var(--radius);
    margin: 1.5rem 0;
  }
</style>
